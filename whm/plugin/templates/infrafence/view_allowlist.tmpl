<div class="ifn-head">
  <h2>[% L.t('allow.title') | html %]</h2>
  <p class="text-muted">[% L.t('allow.intro') | html %]</p>
</div>
<form class="form-inline ifn-add" method="post" action="[% data.script | html %]">
  <input type="hidden" name="page" value="allowlist">
  <input type="hidden" name="action" value="allow">
  <div class="form-group">
    <label for="ifn-allow-ip">[% L.t('allow.ip') | html %]</label>
    <input type="text" id="ifn-allow-ip" name="ip" class="form-control input-sm ifn-mono" required maxlength="45" spellcheck="false" autocomplete="off" placeholder="203.0.113.10" value="[% data.form.ip | html %]">
  </div>
  <div class="form-group">
    <label for="ifn-allow-note">[% L.t('allow.note') | html %]</label>
    <input type="text" id="ifn-allow-note" name="note" class="form-control input-sm" maxlength="200" placeholder="[% L.t('allow.note_hint') | html %]">
  </div>
  <button type="submit" class="btn btn-primary btn-sm">[% L.t('allow.add') | html %]</button>
</form>
[%- IF data.entries.size %]
[% INCLUDE 'infrafence/_toolbar.tmpl' table = 'ifn-allow' %]
<div class="table-responsive">
<table class="table table-striped table-condensed ifn-table" id="ifn-allow">
  <thead><tr>
    <th scope="col">[% L.t('col.ip') | html %]</th>
    <th scope="col">[% L.t('col.note') | html %]</th>
    <th scope="col">[% L.t('col.added_by') | html %]</th>
    <th scope="col">[% L.t('col.added') | html %]</th>
    <th scope="col" class="ifn-actions"><span class="sr-only">[% L.t('col.actions') | html %]</span></th>
  </tr></thead>
  <tbody>
  [%- FOREACH e IN data.entries %]
  <tr>
    <td class="ifn-ip">[% e.ip | html %]</td>
    <td>[% e.note | html %]</td>
    <td>[% e.actor | html %]</td>
    <td><time datetime="[% e.created | html %]">[% L.time(e.created) | html %]</time></td>
    <td class="ifn-actions"><a class="btn btn-default btn-xs" href="[% data.script | html %]?page=allowlist&amp;action=disallow&amp;ip=[% e.ip | uri | html %]">[% L.t('action.disallow') | html %]</a></td>
  </tr>
  [%- END %]
  </tbody>
</table>
</div>
[%- ELSIF !data.list_error %]
<div class="ifn-empty"><p>[% L.t('allow.empty') | html %]</p></div>
[%- END %]

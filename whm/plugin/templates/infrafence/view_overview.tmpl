[%- s = data.status -%]
[%- IF s.ok %]
[%- prot = data.protection %]
[%- hb_age = L.age(s.last_heartbeat) %]
<div class="ifn-state ifn-state-[% prot | html %]">
  <div class="ifn-state-main">
    <h2 class="ifn-state-title"><span class="ifn-dot" aria-hidden="true"></span>[% L.t('overview.state.' _ prot) | html %]</h2>
    <p>[% L.t('overview.state.' _ prot _ '.text') | html %]</p>
  </div>
  [%- IF s.dashboard_url.match('^https://') %]
  <a class="btn btn-primary ifn-open" href="[% s.dashboard_url | html %]" target="_blank" rel="noopener noreferrer">[% L.t('overview.open') | html %] <span aria-hidden="true">&#8599;</span></a>
  [%- END %]
</div>

[%- IF data.counts %]
<div class="row ifn-counts">
  <div class="col-sm-4"><a class="ifn-count" href="[% data.script | html %]?page=bans">
    <span class="ifn-count-n">[% IF data.counts.bans.defined %][% L.number(data.counts.bans) | html %][% ELSE %]&ndash;[% END %]</span>
    <span class="ifn-count-l">[% L.t('overview.count.bans') | html %]</span></a></div>
  <div class="col-sm-4"><a class="ifn-count[% IF data.counts.findings %] ifn-count-warn[% END %]" href="[% data.script | html %]?page=findings">
    <span class="ifn-count-n">[% IF data.counts.findings.defined %][% L.number(data.counts.findings) | html %][% ELSE %]&ndash;[% END %]</span>
    <span class="ifn-count-l">[% L.t('overview.count.findings') | html %]</span></a></div>
  <div class="col-sm-4"><a class="ifn-count" href="[% data.script | html %]?page=events">
    <span class="ifn-count-n">[% IF data.counts.events.defined %][% L.number(data.counts.events) | html %][% IF data.counts.events_more %]+[% END %][% ELSE %]&ndash;[% END %]</span>
    <span class="ifn-count-l">[% L.t('overview.count.events') | html %]</span></a></div>
</div>
[%- END %]

<div class="row">
  <div class="col-md-6">
    <div class="panel panel-default">
      <div class="panel-heading"><h3 class="panel-title">[% L.t('overview.agent') | html %]</h3></div>
      <table class="table ifn-dl">
        <tr><th scope="row">[% L.t('overview.version') | html %]</th><td>[% s.agent_version | html %]</td></tr>
        <tr><th scope="row">[% L.t('overview.service') | html %]</th><td>
          [% IF s.agent_running %]<span class="label label-success">[% L.t('overview.running') | html %]</span>
          [% ELSE %]<span class="label label-danger">[% L.t('overview.not_running') | html %]</span>[% END %]</td></tr>
        <tr><th scope="row">[% L.t('overview.heartbeat') | html %]</th><td>
          [% IF s.last_heartbeat %]
            <time datetime="[% s.last_heartbeat | html %]" title="[% L.time(s.last_heartbeat) | html %]">[% L.ago(s.last_heartbeat) | html %]</time>
            [% IF hb_age.defined && hb_age > 600 %]<span class="label label-warning">[% L.t('overview.heartbeat_stale') | html %]</span>[% END %]
          [% ELSE %]<span class="text-muted">[% L.t('overview.never') | html %]</span>[% END %]</td></tr>
        <tr><th scope="row">[% L.t('overview.agent_id') | html %]</th><td><code>[% s.agent_id | html %]</code></td></tr>
        [%- IF s.hostname %]
        <tr><th scope="row">[% L.t('overview.hostname') | html %]</th><td>[% s.hostname | html %]</td></tr>
        [%- END %]
      </table>
    </div>
  </div>
  <div class="col-md-6">
    <div class="panel panel-default">
      <div class="panel-heading"><h3 class="panel-title">[% L.t('overview.account') | html %]</h3></div>
      <table class="table ifn-dl">
        <tr><th scope="row">[% L.t('overview.connection') | html %]</th><td>
          [% IF s.connected %]<span class="label label-success">[% L.t('overview.connected') | html %]</span>
          [% ELSE %]<span class="label label-warning">[% L.t('overview.disconnected') | html %]</span>[% END %]</td></tr>
        <tr><th scope="row">[% L.t('overview.plan') | html %]</th><td>[% L.label('plan', s.plan) | html %]</td></tr>
        <tr><th scope="row">[% L.t('overview.automode') | html %]</th><td>
          [% am = s.automode %]
          <span class="label label-[% IF am == 'on' %]info[% ELSE %]default[% END %]">[% L.label('automode', am) | html %]</span>
          <span class="help-block ifn-help">[% L.t('overview.automode.help') | html %]</span></td></tr>
      </table>
    </div>
  </div>
</div>
[%- END %]

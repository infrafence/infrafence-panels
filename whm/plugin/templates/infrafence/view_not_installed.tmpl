<div class="ifn-empty-state">
  <h2>[% L.t('missing.title') | html %]</h2>
  <p class="lead">[% L.t('missing.lead') | html %]</p>
  <p>[% L.t('missing.how') | html %]</p>
  <div class="ifn-cmd">
    <pre id="ifn-install-cmd"><code>[% data.install_command | html %]</code></pre>
    <button type="button" class="btn btn-default btn-sm" data-ifn-copy="ifn-install-cmd" data-ifn-done="[% L.t('missing.copied') | html %]">[% L.t('missing.copy') | html %]</button>
  </div>
  <p class="text-muted">[% L.t('missing.after') | html %]</p>
  <p><a class="btn btn-primary" href="[% data.site_url | html %]" target="_blank" rel="noopener noreferrer">[% L.t('missing.learn') | html %] <span aria-hidden="true">&#8599;</span></a></p>
</div>

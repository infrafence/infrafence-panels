<div class="ifn-head">
  <h2>[% L.t('coex.title') | html %]</h2>
  <p class="text-muted">[% L.t('coex.intro') | html %]</p>
</div>
[%- IF data.mode %]
<div class="ifn-mode">
  <span class="label label-[% IF data.mode == 'primary' %]primary[% ELSE %]info[% END %]">[% L.label('mode', data.mode) | html %]</span>
  <span>[% IF L.has('mode.' _ data.mode _ '.text') %][% L.t('mode.' _ data.mode _ '.text') | html %][% END %]</span>
</div>
[%- END %]
[%- IF data.tools.size %]
<div class="table-responsive">
<table class="table table-condensed ifn-table ifn-coex">
  <thead><tr>
    <th scope="col">[% L.t('col.tool') | html %]</th>
    <th scope="col">[% L.t('col.state') | html %]</th>
    <th scope="col">[% L.t('col.handling') | html %]</th>
  </tr></thead>
  <tbody>
  [%- FOREACH t IN data.tools %]
  <tr>
    <td class="ifn-tool">
      <strong>[% t.name | html %]</strong>[% IF t.version %] <span class="text-muted">[% t.version | html %]</span>[% END %]
      <br><small class="text-muted">[% L.label('tool_kind', t.kind) | html %][% IF t.manages_firewall %] &middot; [% L.t('coex.own_rules') | html %][% END %]</small>
      [%- IF t.rulesets.size %]
      <br><small>[% L.t('coex.rulesets') | html %]: [% FOREACH r IN t.rulesets %][% r | html %][% UNLESS loop.last %], [% END %][% END %]</small>
      [%- END %]
    </td>
    <td>[% IF t.active %]<span class="label label-success">[% L.t('coex.active') | html %]</span>[% ELSE %]<span class="label label-default">[% L.t('coex.inactive') | html %]</span>[% END %]</td>
    <td>[% IF L.has('coex_action.' _ t.action_id) %][% L.t('coex_action.' _ t.action_id) | html %][% ELSE %][% t.action | html %][% END %]</td>
  </tr>
  [%- END %]
  </tbody>
</table>
</div>
[%- ELSIF data.gate %]
<div class="ifn-empty"><p>[% L.t('gate.empty') | html %]</p></div>
[%- ELSIF !data.list_error %]
<div class="ifn-empty"><p>[% L.t('coex.none') | html %]</p></div>
[%- END %]

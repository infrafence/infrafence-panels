#!/usr/bin/env perl

# Stand-in for `infrafence-agent` during development and tests. It answers
# `infrafence-agent panel <command> [args] --json` the way the agent does
# (docs/panel-json.md), from copies of the agent's own outputs in
# dev/fixtures/. Replies to actions are the fixture with the address or path
# of the request filled in.
#
# Environment:
#   MOCK_AGENT_SCENARIO  default | stopped | empty | monitor | restricted | hostile
#                        | resolved | starter | unpaid | unknown | paid
#                        stopped: the agent is not running. status answers
#                        status_agent_not_running.json; coexistence and sites
#                        still answer (agent_running false); every other
#                        command answers error_agent_not_running.json.
#                        empty, monitor, restricted, hostile, resolved: replies from
#                        dev/scenarios/<name>/, falling back to dev/fixtures/.
#                        The default fixtures are from an agent before 1.0.34
#                        (events and findings without `state`); resolved: from 1.0.34.
#                        starter, unpaid, unknown, paid: the organization's plan and
#                        protection in `status` (the rest from dev/fixtures/).
#                        starter: plan "starter". unpaid: plan "basic", protection
#                        "disabled" (the dashboard refused the agent for 24 hours).
#                        unknown: plan null (never synced, or an old dashboard).
#                        paid: plan "basic", protection "active".
#   MOCK_AGENT_GATE      old (default) | new. old: an agent before 1.0.34, whose `status`
#                        carries plan and protection only and which answers every command.
#                        new: `status` also carries entitled and entitlement, and every
#                        other command answers plan_required, unpaid or unknown when the
#                        plugin is not included.
#   MOCK_AGENT_PLUGIN_LATEST  a version, or null: `status` carries plugin_installed
#                        (this plugin's VERSION) and plugin_latest (this value), as
#                        agent 1.0.35 and later send them. Unset: an older agent,
#                        without either field.
#   MOCK_AGENT_REFUSE    plan_required | unpaid | unknown: every command but `status`
#                        answers this error (the plan changed after `status`).
#   MOCK_AGENT_FIXTURES  fixtures directory (default: next to this script)
#   MOCK_AGENT_NOW       the clock used by --since (default 2026-10-16T12:01:00Z,
#                        just after the fixtures' newest time)
#   MOCK_AGENT_LOG       append each argv, as a JSON array, to this file
#   MOCK_AGENT_FAULT     timeout | garbage | mismatch | stderr  (test faults)
#   MOCK_AGENT_MAP       fresh (default) | stale | not_connected | old: how `panel map`
#   MOCK_AGENT_SCORE     answers. stale: the last cached reply ("stale":true, an older
#                        generated_at); not_connected: the dashboard was never reached;
#                        old: an agent from before `panel map`/`panel score`
#                        (unknown_command).
#
# Where the environment is cleared (the installed CGI), `mock.conf` next to this
# script sets defaults for these variables, one NAME=value per line.

use strict;
use warnings;

use File::Basename qw(dirname);
use JSON::PP ();
use Time::Local qw(timegm);

if ( open my $conf, '<', dirname(__FILE__) . '/mock.conf' ) {
    while (<$conf>) {
        $ENV{$1} = $2 if /\A(MOCK_AGENT_[A-Z_]+)=(\S*)\s*\z/ && !defined $ENV{$1};
    }
    close $conf;
}

my $JSON      = JSON::PP->new->canonical;
my $fixtures  = $ENV{MOCK_AGENT_FIXTURES} || dirname(__FILE__) . '/fixtures';
my $scenarios = dirname($fixtures) . '/scenarios';
my $scenario  = $ENV{MOCK_AGENT_SCENARIO} || 'default';
my $T         = JSON::PP::true;
my $F         = JSON::PP::false;

if ( my $log = $ENV{MOCK_AGENT_LOG} ) {
    open my $fh, '>>', $log or die "cannot write $log: $!\n";
    print {$fh} $JSON->encode( [@ARGV] ), "\n";
    close $fh;
}

my $fault = $ENV{MOCK_AGENT_FAULT} || '';
if ( $fault eq 'timeout' ) { sleep 30; exit 0 }
if ( $fault eq 'garbage' ) { print "InfraFence agent 1.0.23\nusage: ...\n"; exit 0 }
if ( $fault eq 'stderr' )  { print STDERR "warning: noise on stderr\n" }

sub reply {
    my ($r) = @_;
    print $JSON->encode($r), "\n";
    my $code = $r->{ok} ? 0 : 1;
    $code = 1 if $fault eq 'mismatch';
    exit $code;
}

# Refused before asking the agent: no agent_running key.
sub refuse { reply( { ok => $F, error => $_[0], message => $_[1] } ) }

# Refused by the agent.
sub fail { reply( { ok => $F, agent_running => $T, error => $_[0], message => $_[1] } ) }

sub fixture {
    my ($name) = @_;
    my @dirs = $scenario =~ /\A(?:empty|hostile|monitor|restricted|resolved)\z/ ? ( "$scenarios/$scenario", $fixtures ) : ($fixtures);
    for my $dir (@dirs) {
        my $file = "$dir/$name.json";
        next unless -f $file;
        open my $fh, '<:raw', $file or die "cannot read $file: $!\n";
        local $/;
        return JSON::PP->new->utf8->decode(<$fh>);
    }
    refuse( 'internal_error', "mock: no fixture $name" );
}

sub epoch {
    my ($s) = @_;
    my @p = $s =~ /\A(\d{4})-(\d\d)-(\d\d)T(\d\d):(\d\d):(\d\d)(?:\.\d+)?(?:Z|[+-]00:?00)\z/ or return undef;
    return timegm( $p[5], $p[4], $p[3], $p[2], $p[1] - 1, $p[0] );
}

my @args = @ARGV;
refuse( 'bad_request', 'usage: infrafence-agent panel <command> [args] --json' ) unless @args && shift(@args) eq 'panel';
my $json = grep { $_ eq '--json' } @args;
@args = grep { $_ ne '--json' } @args;
unless ($json) { print "human output is not part of the panel contract\n"; exit 2 }

my $command = shift @args;
refuse( 'bad_request', 'missing command' ) unless defined $command;

my %SPEC = (
    status      => { pos => 0, opts => [] },
    bans        => { pos => 0, opts => ['limit'] },
    unban       => { pos => 1, opts => ['actor'], actor => 1 },
    allow       => { pos => 1, opts => [ 'note', 'actor' ], actor => 1 },
    allowlist   => { pos => 0, opts => [] },
    disallow    => { pos => 1, opts => ['actor'], actor => 1 },
    findings    => { pos => 0, opts => ['limit'] },
    events      => { pos => 0, opts => [ 'limit', 'since' ] },
    coexistence => { pos => 0, opts => [] },
    sites       => { pos => 0, opts => [] },
    scan        => { pos => 1, opts => ['actor'], actor => 1 },
    map         => { pos => 0, opts => ['hours'] },
    score       => { pos => 0, opts => [] },
);
# An agent from before `panel map` and `panel score` does not know them.
for my $c (qw(map score)) {
    refuse( 'unknown_command', "unknown command: $c" ) if $command eq $c && ( $ENV{ 'MOCK_AGENT_' . uc $c } || '' ) eq 'old';
}
my $spec = $SPEC{$command} or refuse( 'unknown_command', "unknown command: $command" );

my ( @pos, %opt );
while (@args) {
    my $a = shift @args;
    if ( $a =~ /\A--([a-z]+)\z/ ) {
        my $name = $1;
        refuse( 'bad_request', "unknown option --$name" ) unless grep { $_ eq $name } @{ $spec->{opts} };
        refuse( 'bad_request', "--$name needs a value" ) unless @args;
        $opt{$name} = shift @args;
    }
    else {
        push @pos, $a;
    }
}
refuse( 'bad_request', "$command takes $spec->{pos} argument(s)" ) unless @pos == $spec->{pos};
if ( defined $opt{limit} ) {
    refuse( 'bad_request', '--limit must be 1-500' ) unless $opt{limit} =~ /\A[1-9][0-9]{0,2}\z/ && $opt{limit} <= 500;
}
my $limit = defined $opt{limit} ? $opt{limit} : 50;
if ( $spec->{actor} ) {
    refuse( 'invalid_actor', '--actor must be 1-64 of A-Z a-z 0-9 . _ @ - +' )
      unless defined $opt{actor} && $opt{actor} =~ /\A[A-Za-z0-9._\@+-]{1,64}\z/;
}
if ( defined $opt{note} ) {
    refuse( 'bad_request', 'invalid --note' ) if length $opt{note} > 200 || $opt{note} =~ /[\x00-\x1f\x7f]/;
}

# Arguments checked before asking the agent.
my $target = $pos[0];
if ( grep { $command eq $_ } qw(unban allow disallow) ) {
    refuse( 'invalid_ip', 'not a single IPv4 or IPv6 address' )
      unless defined $target && $target =~ /\A(?:\d{1,3}(?:\.\d{1,3}){3}|[0-9A-Fa-f:]*:[0-9A-Fa-f:.]*)\z/
      && $target ne '0.0.0.0' && $target ne '::';
}
if ( $command eq 'scan' ) {
    refuse( 'invalid_path', 'not a clean absolute path' )
      unless $target =~ m{\A/} && $target !~ m{(?:\A|/)\.\.?(?:/|\z)} && $target !~ m{//} && $target !~ /[\x00-\x1f]/;
}

my $stopped = $scenario eq 'stopped';

# The organization's plan and protection, as the agent reports them.
my %PLAN = (
    starter => { plan => 'starter' },
    unpaid  => {
        plan           => 'basic',
        protection     => 'disabled',
        connected      => $F,
        last_heartbeat => '2026-10-15T07:59:00Z',
        refused_since  => '2026-10-15T08:00:00Z',
        disabled_at    => '2026-10-16T08:00:00Z',
    },
    unknown => { plan => undef, last_sync => undef },
    paid    => { plan => 'basic' },
);
sub status {
    my $r = fixture( $stopped ? 'status_agent_not_running' : 'status' );
    if ( my $p = $PLAN{$scenario} ) {
        $r->{protection} = 'active';
        $r->{$_} = undef for qw(refused_since disabled_at);
        $r->{$_} = $p->{$_} for keys %$p;
    }
    # Agent 1.0.34 and later: the plugin is included in the paid plans while
    # protection is not switched off.
    if ( ( $ENV{MOCK_AGENT_GATE} || 'old' ) eq 'new' ) {
        my $plan = $r->{plan};
        my $prot = defined $r->{protection} ? $r->{protection} : '';
        $r->{entitlement} =
            defined $plan && !( grep { $plan eq $_ } qw(basic pro automode) ) ? 'plan_required'
          : $prot eq 'disabled'                                          ? 'unpaid'
          : !defined $plan                                               ? 'unknown'
          :                                                                'ok';
        $r->{entitled} = $r->{entitlement} eq 'ok' ? $T : $F;
    }
    # Agent 1.0.35 and later: the installed plugin and the latest release.
    if ( defined( my $latest = $ENV{MOCK_AGENT_PLUGIN_LATEST} ) ) {
        $r->{plugin_installed} = plugin_version();
        $r->{plugin_latest}    = $latest eq 'null' || $stopped ? undef : $latest;
    }
    return $r;
}
sub plugin_version {
    open my $fh, '<', dirname(__FILE__) . '/../VERSION' or return undef;
    my $v = <$fh>;
    close $fh;
    chomp $v if defined $v;
    return $v;
}
reply( status() ) if $command eq 'status';

my %GATE_MESSAGE = (
    plan_required => 'the panel plugin is included in the Basic, Pro and AutoMode plans',
    unpaid        => 'the subscription is not active: the panel plugin shows no data until it is',
    unknown       => 'the plan has not been received from the InfraFence dashboard yet',
);
if ( my $code = $ENV{MOCK_AGENT_REFUSE} ) {
    refuse( $code, $GATE_MESSAGE{$code} || $code );
}
if ( ( $ENV{MOCK_AGENT_GATE} || 'old' ) eq 'new' && !$stopped ) {
    my $e = status()->{entitlement};
    refuse( $e, $GATE_MESSAGE{$e} ) unless $e eq 'ok';
}
if ( $command eq 'coexistence' || $command eq 'sites' ) {
    my $r = fixture($command);
    if ($stopped) {
        $r->{agent_running}        = $F;
        $r->{malware_scan_enabled} = undef if $command eq 'sites';
    }
    reply($r);
}
reply( fixture('error_agent_not_running') ) if $stopped;

# Cached replies from the dashboard (docs/panel-json.md, `map` and `score`).
if ( $command eq 'map' || $command eq 'score' ) {
    my $hours = defined $opt{hours} ? $opt{hours} : '24';
    refuse( 'bad_request', '--hours must be 24 or 168' ) unless $hours eq '24' || $hours eq '168';
    my $mode = $ENV{ 'MOCK_AGENT_' . uc $command } || 'fresh';
    if ( $mode eq 'not_connected' ) {
        reply( { ok => $F, agent_running => $T, error => 'not_connected', message => 'the InfraFence dashboard has not been reached yet' } );
    }
    my $r = fixture( $command eq 'map' && $hours eq '168' ? 'map_168' : $command );
    if ( $mode eq 'stale' ) {
        $r->{stale}        = $T;
        $r->{connected}    = $F;
        $r->{generated_at} = '2026-10-16T09:40:00Z';
    }
    reply($r);
}

sub limited {
    my ( $r, $field ) = @_;
    splice @{ $r->{$field} }, $limit if @{ $r->{$field} } > $limit;
    reply($r);
}

limited( fixture('bans'),     'bans' )     if $command eq 'bans';
limited( fixture('findings'), 'findings' ) if $command eq 'findings';
if ( $command eq 'events' ) {
    my $r = fixture('events');
    if ( defined( my $since = $opt{since} ) ) {
        my $now = epoch( $ENV{MOCK_AGENT_NOW} || '2026-10-16T12:01:00Z' );
        my $from;
        if    ( $since =~ /\A(\d+)h\z/ ) { $from = $now - $1 * 3600 }
        elsif ( $since =~ /\A(\d+)m\z/ ) { $from = $now - $1 * 60 }
        else                             { $from = epoch($since) }
        refuse( 'bad_request', 'invalid --since' ) unless defined $from && $now - $from <= 90 * 86400;
        $r->{events} = [ grep { my $t = epoch( $_->{time} ); defined $t && $t >= $from } @{ $r->{events} } ];
    }
    limited( $r, 'events' );
}
reply( fixture('allowlist') ) if $command eq 'allowlist';

my @bans  = @{ fixture('bans')->{bans} };
my @allow = @{ fixture('allowlist')->{allowlist} };

if ( $command eq 'unban' ) {
    my ($ban) = grep { $_->{ip} eq $target } @bans;
    fail( 'not_banned', "$target is not banned by InfraFence on this server" ) unless $ban;
    my $r = fixture('unban');
    $r->{ip}     = $target;
    $r->{source} = $ban->{source};
    $r->{lifted_until} = $ban->{expires} if defined $ban->{expires};
    reply($r);
}
# Stands for the server's own public address in the mock.
my $OWN = '192.0.2.1';
if ( $command eq 'allow' ) {
    fail( 'loopback_address', "$target is a loopback address" ) if $target =~ /\A127\./ || $target eq '::1';
    my $own = $target eq $OWN ? $T : $F;
    reply( { ok => $T, agent_running => $T, ip => $target, already => $T, own_address => $own } )
      if $own || grep { $_->{address} eq $target } @allow;
    my $r = fixture('allow');
    $r->{ip}          = $target;
    $r->{banned}      = ( grep { $_->{ip} eq $target } @bans ) ? $T : $F;
    $r->{own_address} = $own;
    reply($r);
}
if ( $command eq 'disallow' ) {
    my ($e) = grep { $_->{address} eq $target } @allow;
    fail( 'not_in_allowlist', "$target is not on the allow list" ) unless $e;
    fail( 'managed_by_dashboard', "$target is on the organization's allow list; remove it in the dashboard" )
      if $e->{source} ne 'panel';
    my $r = fixture('disallow');
    $r->{ip} = $target;
    reply($r);
}
if ( $command eq 'scan' ) {
    my @sites = grep { defined $_->{document_root} && $_->{document_root} eq $target } @{ fixture('sites')->{sites} };
    fail( 'not_a_document_root', "$target is not the document root of any site" ) unless @sites;
    fail( 'not_scannable', "$target does not belong to the site's account" ) unless grep { $_->{scannable} } @sites;
    my $r = fixture('scan');
    $r->{path} = $target;
    reply($r);
}

refuse( 'internal_error', "mock: unhandled command $command" );

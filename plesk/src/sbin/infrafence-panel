#!/bin/bash
### InfraFence for Plesk: privileged wrapper.
###
### Installed by Plesk into /usr/local/psa/admin/sbin/modules/infrafence/ and run as root through
### pm_ApiCli::callSbin(). It accepts only the panel contract commands (docs/panel-contract.md),
### validates every argument, and execs the agent with an argv array:
###
###     infrafence-agent panel <command> [args] --json
###
### Nothing is evaluated by a shell, nothing is written, and the environment is cleared before exec.
### The agent only runs if it is a root-owned file that no other user can modify.

set -u
umask 077
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
export LC_ALL=C

readonly AGENT_CANDIDATES=(
    /usr/sbin/infrafence-agent
    /usr/bin/infrafence-agent
    /usr/local/sbin/infrafence-agent
    /usr/local/bin/infrafence-agent
    /opt/infrafence/bin/infrafence-agent
)
readonly TIMEOUT_SECONDS=25

# Replies with a contract error. Messages are fixed strings, never user input.
fail() {
    printf '{"ok":false,"error":"%s","message":"%s"}\n' "$1" "$2"
    exit "${3:-2}"
}

# True when the path is owned by root and not writable by group or others.
root_only_writable() {
    local owner mode
    read -r owner mode < <(stat -L -c '%u %a' -- "$1" 2>/dev/null) || return 1
    [[ "$owner" == 0 && "$mode" =~ ^[0-7]{3,4}$ ]] || return 1
    (( (8#$mode & 8#022) == 0 ))
}

# Sets AGENT to the first installed agent binary. Returns 1 if none, 2 if it is not safe to run.
find_agent() {
    local bin real
    for bin in "${AGENT_CANDIDATES[@]}"; do
        [[ -e "$bin" ]] || continue
        real=$(readlink -f -- "$bin") || continue
        [[ -f "$real" && -x "$real" ]] || continue
        root_only_writable "$real" || return 2
        root_only_writable "$(dirname -- "$real")" || return 2
        AGENT=$real
        return 0
    done
    return 1
}

valid_ipv4() {
    local re='^(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])(\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])){3}$'
    [[ "$1" =~ $re ]]
}

# Shape check only; the extension validates the address strictly before calling, and so does the agent.
valid_ipv6() {
    [[ "$1" =~ ^[0-9A-Fa-f:.]{2,45}$ && "$1" == *:* && "$1" != *:::* ]]
}

valid_ip() {
    valid_ipv4 "$1" || valid_ipv6 "$1"
}

# $2 and $3: the shortest prefix accepted for IPv4 and IPv6.
valid_ip_or_cidr() {
    local addr prefix min4=${2:-16} min6=${3:-48}
    if [[ "$1" == */* ]]; then
        addr=${1%/*}
        prefix=${1##*/}
        [[ "$prefix" =~ ^[0-9]{1,3}$ ]] || return 1
        if valid_ipv4 "$addr"; then
            (( 10#$prefix >= min4 && 10#$prefix <= 32 ))
        else
            valid_ipv6 "$addr" && (( 10#$prefix >= min6 && 10#$prefix <= 128 ))
        fi
    else
        valid_ip "$1"
    fi
}

valid_actor() {
    [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._@:+-]{0,99}$ ]]
}

# Free text, passed as one argv element. No control characters, no leading dash.
valid_note() {
    [[ ${#1} -le 400 && "$1" != -* && ! "$1" =~ [[:cntrl:]] ]]
}

valid_limit() {
    [[ "$1" =~ ^[0-9]{1,4}$ ]] && (( 10#$1 >= 1 && 10#$1 <= 1000 ))
}

valid_since() {
    [[ "$1" =~ ^[0-9]{1,4}[smhd]$ || "$1" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$ ]]
}

vhosts_root() {
    local dir=""
    if [[ -r /etc/psa/psa.conf ]]; then
        dir=$(awk '$1 == "HTTPD_VHOSTS_D" { print $2; exit }' /etc/psa/psa.conf)
    fi
    [[ "$dir" == /* ]] || dir=/var/www/vhosts
    readlink -f -- "$dir"
}

# Prints the resolved document root if it is an existing directory inside the Plesk vhosts directory.
resolve_docroot() {
    local path=$1 root real
    [[ "$path" == /* && ${#path} -le 1024 ]] || return 1
    [[ "$path" =~ ^[A-Za-z0-9._@+/-]+$ ]] || return 1
    [[ "$path" != *//* && "$path" != */../* && "$path" != */.. && "$path" != */./* ]] || return 1
    root=$(vhosts_root) || return 1
    real=$(readlink -e -- "$path") || return 1
    [[ -d "$real" && "$real" == "$root"/* ]] || return 1
    printf '%s' "$real"
}

[[ $# -ge 1 ]] || fail invalid_arguments "No command given."
command=$1
shift

args=()
positional=""
actor=""
need_target=0
need_actor=0
options=""

case "$command" in
    status|coexistence|sites|allowlist) ;;
    bans|findings) options="--limit" ;;
    events) options="--limit --since" ;;
    unban|disallow) need_target=1; need_actor=1 ;;
    allow) need_target=1; need_actor=1; options="--note" ;;
    scan) need_target=1; need_actor=1 ;;
    *) fail unknown_command "Unknown command." ;;
esac

while [[ $# -gt 0 ]]; do
    case "$1" in
        --actor)
            [[ $need_actor -eq 1 && $# -ge 2 && -z "$actor" ]] || fail invalid_arguments "Unexpected --actor."
            valid_actor "$2" || fail invalid_arguments "Invalid actor."
            actor=$2
            shift 2
            ;;
        --limit|--since|--note)
            [[ " $options " == *" $1 "* && $# -ge 2 ]] || fail invalid_arguments "Unexpected option."
            case "$1" in
                --limit) valid_limit "$2" || fail invalid_arguments "Invalid limit." ;;
                --since) valid_since "$2" || fail invalid_arguments "Invalid time." ;;
                --note) valid_note "$2" || fail invalid_arguments "Invalid note." ;;
            esac
            args+=("$1" "$2")
            shift 2
            ;;
        -*)
            fail invalid_arguments "Unknown option."
            ;;
        *)
            [[ $need_target -eq 1 && -z "$positional" ]] || fail invalid_arguments "Unexpected argument."
            positional=$1
            shift
            ;;
    esac
done

if [[ $need_target -eq 1 ]]; then
    [[ -n "$positional" ]] || fail invalid_arguments "Missing argument."
    case "$command" in
        unban) valid_ip "$positional" || fail invalid_ip "Invalid IP address." ;;
        allow) valid_ip_or_cidr "$positional" 16 48 || fail invalid_ip "Invalid IP address or network." ;;
        # Removing an entry is always allowed, even a wide one added from the dashboard.
        disallow) valid_ip_or_cidr "$positional" 0 0 || fail invalid_ip "Invalid IP address or network." ;;
        scan) positional=$(resolve_docroot "$positional") || fail invalid_path "The path is not a document root inside the Plesk vhosts directory." ;;
    esac
fi
if [[ $need_actor -eq 1 ]]; then
    [[ -n "$actor" ]] || fail invalid_arguments "Missing --actor."
    args+=(--actor "$actor")
fi

AGENT=""
find_agent
case $? in
    0) ;;
    2) fail agent_untrusted "The agent binary or its directory is not owned by root, or is writable by other users." 5 ;;
    *) fail agent_not_installed "The InfraFence agent is not installed on this server." 3 ;;
esac

argv=("$AGENT" panel "$command")
[[ -n "$positional" ]] && argv+=("$positional")
argv+=("${args[@]}" --json)

exec env -i PATH="$PATH" LC_ALL=C.UTF-8 LANG=C.UTF-8 \
    timeout --kill-after=5 "$TIMEOUT_SECONDS" "${argv[@]}"

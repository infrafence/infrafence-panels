#!/bin/bash
### InfraFence for Plesk: privileged wrapper.
###
### Installed by Plesk into /usr/local/psa/admin/sbin/modules/infrafence/ and run as root through
### pm_ApiCli::callSbin(). It accepts only the panel contract commands (docs/panel-contract.md),
### validates every argument, and execs the agent with an argv array:
###
###     infrafence-agent panel <command> [args] --json
###
### Usage: infrafence-panel [--timeout <1-25 seconds>] <command> [args]
###
### Nothing is evaluated by a shell, nothing is written, and the environment is cleared before exec.
### The agent only runs if it is a root-owned file that no other user can modify, in directories
### that no other user can modify, all the way from /.
###
### Plesk runs this file as root through its setuid-root helper (pm_ApiCli::callSbin ->
### /usr/local/psa/admin/sbin/mod_wrapper, mode 4510 root:psaadm). The file is installed 0755 root:root:
### Plesk's extension installer sets that mode on every sbin file, and an extension's install scripts
### run as psaadm, so they cannot change it (tested on Plesk 18.0.81: chmod is "Operation not permitted").
### Run directly by any other user, the wrapper refuses at once (not_root) and never reaches the agent.
### Refusals use the agent's error shape and codes, without "agent_running" (the agent was not asked),
### plus two codes of its own: agent_not_installed and agent_untrusted.

set -u
umask 077
unset BASH_ENV ENV CDPATH
IFS=$' \t\n'
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
export LC_ALL=C

readonly AGENT_CANDIDATES=(
    /usr/sbin/infrafence-agent
    /usr/bin/infrafence-agent
    /usr/local/sbin/infrafence-agent
    /usr/local/bin/infrafence-agent
    /opt/infrafence/bin/infrafence-agent
)
readonly MAX_TIMEOUT_SECONDS=25

# Replies with a contract error. Messages are fixed strings, never user input.
fail() {
    printf '{"error":"%s","message":"%s","ok":false}\n' "$1" "$2"
    exit 1
}

# True when the path is owned by root and not writable by group or others.
root_only_writable() {
    local owner mode
    read -r owner mode < <(stat -L -c '%u %a' -- "$1" 2>/dev/null) || return 1
    [[ "$owner" == 0 && "$mode" =~ ^[0-7]{3,4}$ ]] || return 1
    (( (8#$mode & 8#022) == 0 ))
}

# True when the file and every directory above it, up to /, are root-owned and not writable by
# group or others: nobody but root can replace the file or any part of its path.
root_only_path() {
    local path=$1
    root_only_writable "$path" || return 1
    while [[ "$path" != / ]]; do
        path=$(dirname -- "$path")
        root_only_writable "$path" || return 1
    done
}

# Sets AGENT to the first installed agent binary. Returns 1 if none, 2 if it is not safe to run.
find_agent() {
    local bin real
    for bin in "${AGENT_CANDIDATES[@]}"; do
        [[ -e "$bin" ]] || continue
        real=$(readlink -e -- "$bin") || continue
        [[ -f "$real" && -x "$real" ]] || continue
        root_only_path "$real" || return 2
        AGENT=$real
        return 0
    done
    return 1
}

valid_ipv4() {
    local re='^(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])(\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])){3}$'
    [[ "$1" =~ $re ]]
}

# Shape check only; the extension validates the address strictly before calling, and so does the agent.
valid_ipv6() {
    [[ "$1" =~ ^[0-9A-Fa-f:.]{2,45}$ && "$1" == *:* && "$1" != *:::* ]]
}

valid_ip() {
    valid_ipv4 "$1" || valid_ipv6 "$1"
}

# As the agent: 1-64 of A-Z a-z 0-9 . _ @ - +, and no leading dash so it is never read as an option.
valid_actor() {
    [[ "$1" =~ ^[A-Za-z0-9._@+][A-Za-z0-9._@+-]{0,63}$ ]]
}

# Free text, passed as one argv element: up to 200 bytes (LC_ALL=C counts bytes), no control
# characters, no leading dash.
valid_note() {
    [[ ${#1} -le 200 && "$1" != -* && ! "$1" =~ [[:cntrl:]] ]]
}

valid_limit() {
    [[ "$1" =~ ^[0-9]{1,3}$ ]] && (( 10#$1 >= 1 && 10#$1 <= 500 ))
}

valid_timeout() {
    [[ "$1" =~ ^[0-9]{1,2}$ ]] && (( 10#$1 >= 1 && 10#$1 <= MAX_TIMEOUT_SECONDS ))
}

valid_since() {
    [[ "$1" =~ ^[0-9]{1,7}[smhd]$ || "$1" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$ ]]
}

# The vhosts directory as Plesk is configured (HTTPD_VHOSTS_D), not resolved.
vhosts_dir() {
    local dir=""
    if [[ -r /etc/psa/psa.conf ]]; then
        dir=$(awk '$1 == "HTTPD_VHOSTS_D" { print $2; exit }' /etc/psa/psa.conf)
    fi
    [[ "$dir" == /* ]] || dir=/var/www/vhosts
    printf '%s' "${dir%/}"
}

# A clean absolute path: no relative parts, no doubled slashes, a conservative character set.
clean_path() {
    local path=$1
    [[ "$path" == /* && ${#path} -le 1024 ]] || return 1
    [[ "$path" =~ ^[A-Za-z0-9._@+/-]+$ ]] || return 1
    [[ "$path" != *//* && "$path" != */../* && "$path" != */.. && "$path" != */./* && "$path" != */. ]] || return 1
    [[ "$path" == / || "$path" != */ ]]
}

# Checks a document root for scan and prints it with every symlink resolved. Returns 1 if it is not an
# existing directory inside the Plesk vhosts directory, 2 if it is a symlink or goes through one below
# the vhosts directory (the vhosts directory itself may be a symlink, as on some servers).
# The resolved path is what the agent gets; the agent then checks that it is the document root of a
# site, owned by the site's account, and never follows symlinks itself.
resolve_docroot() {
    local dir root real expected
    dir=$(vhosts_dir)
    root=$(readlink -e -- "$dir") || return 1
    real=$(readlink -e -- "$1") || return 1
    [[ -d "$real" && "$real" == "$root"/* ]] || return 1
    clean_path "$real" || return 1
    if [[ "$1" == "$dir"/* ]]; then
        expected=$root${1#"$dir"}
    elif [[ "$1" == "$root"/* ]]; then
        expected=$1
    else
        return 1
    fi
    [[ "$real" == "$expected" ]] || return 2
    printf '%s' "$real"
}

[[ "$(id -u)" -eq 0 ]] || fail not_root "The wrapper must run as root."

timeout_seconds=$MAX_TIMEOUT_SECONDS
if [[ $# -ge 2 && "$1" == --timeout ]]; then
    valid_timeout "$2" || fail bad_request "Invalid timeout."
    (( timeout_seconds = 10#$2 ))
    shift 2
fi

[[ $# -ge 1 ]] || fail bad_request "No command given."
command=$1
shift

args=()
positional=""
actor=""
need_target=0
need_actor=0
options=""

case "$command" in
    status|coexistence|sites|allowlist) ;;
    bans|findings) options="--limit" ;;
    events) options="--limit --since" ;;
    unban|disallow) need_target=1; need_actor=1 ;;
    allow) need_target=1; need_actor=1; options="--note" ;;
    scan) need_target=1; need_actor=1 ;;
    *) fail unknown_command "Unknown command." ;;
esac

while [[ $# -gt 0 ]]; do
    case "$1" in
        --actor)
            [[ $need_actor -eq 1 && $# -ge 2 && -z "$actor" ]] || fail bad_request "Unexpected --actor."
            valid_actor "$2" || fail invalid_actor "Invalid actor."
            actor=$2
            shift 2
            ;;
        --limit|--since|--note)
            [[ " $options " == *" $1 "* && $# -ge 2 ]] || fail bad_request "Unexpected option."
            case "$1" in
                --limit) valid_limit "$2" || fail bad_request "Invalid limit." ;;
                --since) valid_since "$2" || fail bad_request "Invalid time." ;;
                --note) valid_note "$2" || fail bad_request "Invalid note." ;;
            esac
            args+=("$1" "$2")
            shift 2
            ;;
        -*)
            fail bad_request "Unknown option."
            ;;
        *)
            [[ $need_target -eq 1 && -z "$positional" ]] || fail bad_request "Unexpected argument."
            positional=$1
            shift
            ;;
    esac
done

if [[ $need_target -eq 1 ]]; then
    [[ -n "$positional" ]] || fail bad_request "Missing argument."
    case "$command" in
        unban|allow|disallow) valid_ip "$positional" || fail invalid_ip "Invalid IP address." ;;
        scan)
            clean_path "$positional" || fail invalid_path "Not a clean absolute path."
            resolved=$(resolve_docroot "$positional")
            status=$?
            if [[ $status -eq 2 ]]; then
                fail not_scannable "The document root is a symlink or goes through one."
            elif [[ $status -ne 0 ]]; then
                fail not_a_document_root "Not a directory inside the Plesk vhosts directory."
            fi
            positional=$resolved
            ;;
    esac
fi
if [[ $need_actor -eq 1 ]]; then
    [[ -n "$actor" ]] || fail invalid_actor "Missing --actor."
    args+=(--actor "$actor")
fi

AGENT=""
find_agent
case $? in
    0) ;;
    2) fail agent_untrusted "The agent binary or a directory above it is not owned by root, or is writable by other users." ;;
    *) fail agent_not_installed "The InfraFence agent is not installed on this server." ;;
esac

argv=("$AGENT" panel "$command")
[[ -n "$positional" ]] && argv+=("$positional")
argv+=("${args[@]}" --json)

exec env -i PATH="$PATH" LC_ALL=C.UTF-8 LANG=C.UTF-8 \
    timeout --kill-after=5 "$timeout_seconds" "${argv[@]}"
